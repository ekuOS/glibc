 # Helper objects for some tests.
@@ -426,6 +426,10 @@ endif
 
 include ../Rules
 
+# The Dart builder compiles the upstream amalgamation once as a PIC object.
+$(addprefix $(objpfx)eku-mimalloc,$(object-suffixes)): $(ekuos-mimalloc-object)
+	$(INSTALL_DATA) $< $@
+
 CFLAGS-mcheck-init.c += $(PIC-ccflag)
 CFLAGS-obstack.c += $(uses-callbacks)
 

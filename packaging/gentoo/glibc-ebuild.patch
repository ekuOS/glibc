--- a/glibc-2.44-r4.ebuild
+++ b/glibc-2.44-r4.ebuild
@@ -57 +57,4 @@
-LICENSE="LGPL-2.1+ BSD HPND ISC inner-net rc PCRE"
+MIMALLOC_VERSION=3.7.0
+SRC_URI+=" https://codeload.github.com/microsoft/mimalloc/tar.gz/refs/tags/v${MIMALLOC_VERSION} -> mimalloc-${MIMALLOC_VERSION}.tar.gz"
+
+LICENSE="LGPL-2.1+ BSD HPND ISC inner-net rc PCRE MIT"
@@ -662,4 +665 @@
-	# glibc does not work with non-bfd (for various reasons):
-	# * gold (bug #269274)
-	# * mold (bug #860900)
-	tc-ld-force-bfd
+	# ekuOS uses LLD and the compatibility patches staged by build.dart.
@@ -1046,0 +1047 @@
+	unpack "mimalloc-${MIMALLOC_VERSION}.tar.gz"
@@ -1078,0 +1080,3 @@
+	/usr/local/bin/ekuos-binhost prepare "${S}" "${FILESDIR}/ekuos" \
+		"${FILESDIR}/ekuos/eku-malloc.c" || die
+
@@ -1094,0 +1099,6 @@
+	use clang && tc-is-clang || die "ekuOS glibc requires Clang"
+	export libc_cv_sfp_handle_exceptions
+	libc_cv_sfp_handle_exceptions=$(/usr/local/bin/ekuos-binhost soft-float ${glibc__abi_CFLAGS}) || die
+	local hardening
+	hardening=$(/usr/local/bin/ekuos-binhost hardening) || die
+
@@ -1115 +1125,6 @@
-		amd64-x86_64-*|x32-x86_64-*-*-gnux32) myconf+=( $(use_enable cet) ) ;;
+		amd64-x86_64-*)
+			local cet_flag=--enable-cet=no
+			if use cet; then
+				cet_flag=$(/usr/local/bin/ekuos-binhost cet) || die
+			fi
+			myconf+=( "${cet_flag}" ) ;;
@@ -1161,2 +1176,2 @@
-		--enable-bind-now
-		--enable-fortify-source
+		--disable-static-c++-link-check
+		${hardening}
@@ -1375 +1390,12 @@
-	emake -C "$(builddir nptl)"
+	local builddir=$(builddir nptl)
+	local mimalloc="${WORKDIR}/mimalloc-${MIMALLOC_VERSION}"
+	local cet_enabled=no
+	if [[ ${ABI} == amd64 ]] && use cet; then
+		cet_enabled=yes
+	fi
+
+	# Reuse the same Clang allocator build as build.dart for each ABI.
+	/usr/local/bin/ekuos-binhost mimalloc "${mimalloc}" "${builddir}/ekuos-mimalloc.o" \
+		"${cet_enabled}" -march=x86-64 -mtune=generic ${glibc__abi_CFLAGS} || die
+	printf 'ekuos-mimalloc-object := %s/ekuos-mimalloc.o\n' "${builddir}" > "${builddir}/configparms" || die
+	emake -C "${builddir}"

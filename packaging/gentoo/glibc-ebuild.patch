--- a/glibc-2.44-r4.ebuild
+++ b/glibc-2.44-r4.ebuild
@@ -57 +57,4 @@
-LICENSE="LGPL-2.1+ BSD HPND ISC inner-net rc PCRE"
+MIMALLOC_VERSION=3.7.0
+SRC_URI+=" https://codeload.github.com/microsoft/mimalloc/tar.gz/refs/tags/v${MIMALLOC_VERSION} -> mimalloc-${MIMALLOC_VERSION}.tar.gz"
+
+LICENSE="LGPL-2.1+ BSD HPND ISC inner-net rc PCRE MIT multilib? ( libgcc )"
@@ -662,4 +665 @@
-	# glibc does not work with non-bfd (for various reasons):
-	# * gold (bug #269274)
-	# * mold (bug #860900)
-	tc-ld-force-bfd
+	# ekuOS uses LLD and the compatibility patches staged by build.dart.
@@ -744 +744,7 @@
-	export glibc__abi_CFLAGS="$(get_abi_CFLAGS)"
+	export glibc__abi_CFLAGS="$(get_abi_CFLAGS)"
+	if [[ ${ABI} == x86 ]] && tc-is-clang; then
+		# Clang rejects explicit -mfpmath=sse on glibc objects built
+		# with -mgeneral-regs-only. The target still enables SSE2 for
+		# the objects that can use it.
+		glibc__abi_CFLAGS=${glibc__abi_CFLAGS//-mfpmath=sse/}
+	fi
@@ -1046,0 +1053 @@
+	unpack "mimalloc-${MIMALLOC_VERSION}.tar.gz"
@@ -1078,0 +1086,3 @@
+	/usr/local/bin/ekuos-binhost prepare "${S}" "${FILESDIR}/ekuos" \
+		"${FILESDIR}/ekuos/eku-malloc.c" || die
+
@@ -1094,0 +1105,6 @@
+	use clang && tc-is-clang || die "ekuOS glibc requires Clang"
+	export libc_cv_sfp_handle_exceptions
+	libc_cv_sfp_handle_exceptions=$(/usr/local/bin/ekuos-binhost soft-float ${glibc__abi_CFLAGS}) || die
+	local hardening
+	hardening=$(/usr/local/bin/ekuos-binhost hardening) || die
+
@@ -1115 +1131,6 @@
-		amd64-x86_64-*|x32-x86_64-*-*-gnux32) myconf+=( $(use_enable cet) ) ;;
+		amd64-x86_64-*)
+			local cet_flag=--enable-cet=no
+			if use cet; then
+				cet_flag=$(/usr/local/bin/ekuos-binhost cet) || die
+			fi
+			myconf+=( "${cet_flag}" ) ;;
@@ -1161,2 +1182,2 @@
-		--enable-bind-now
-		--enable-fortify-source
+		--disable-static-c++-link-check
+		${hardening}
@@ -1375 +1396,38 @@
-	emake -C "$(builddir nptl)"
+	local builddir=$(builddir nptl)
+	local mimalloc="${WORKDIR}/mimalloc-${MIMALLOC_VERSION}"
+	local cet_enabled=no
+	if [[ ${ABI} == amd64 ]] && use cet; then
+		cet_enabled=yes
+	fi
+
+	# Reuse the same Clang allocator build as build.dart for each ABI.
+	/usr/local/bin/ekuos-binhost mimalloc "${mimalloc}" "${builddir}/ekuos-mimalloc.o" \
+		"${cet_enabled}" -march=x86-64 -mtune=generic ${glibc__abi_CFLAGS} || die
+	printf 'ekuos-mimalloc-object := %s/ekuos-mimalloc.o\n' "${builddir}" > "${builddir}/configparms" || die
+	if [[ ${ABI} == x86 ]]; then
+		# LLVM 22's i386 builtins omit the software binary128 routines.
+		# Keep compiler-rt first and resolve only missing builtins from
+		# the i386 libgcc archive; this adds no shared libgcc dependency.
+		local fallback
+		fallback=$(${glibc__GLIBC_CC} -m32 --rtlib=libgcc -print-libgcc-file-name) || die
+		[[ ${fallback} = /* && -f ${fallback} ]] || die "Missing i386 libgcc.a"
+		printf 'libgcc-name += %s\n' "${fallback}" >> "${builddir}/configparms" || die
+		# Unlike libc.so, libm.so does not use libc.so-gnulib.
+		printf '%s\n' 'LDLIBS-m.so += $(libgcc-name)' \
+			>> "${builddir}/configparms" || die
+	fi
+	emake -C "${builddir}"
+	if [[ ${ABI} == x86 ]] && use static-libs; then
+		# Static consumers must also link with compiler-rt alone. Include
+		# only the binary128 helpers (and their dependencies) in libc.a.
+		local -a binary128
+		mapfile -t binary128 < <(
+			llvm-nm --defined-only --extern-only --format=posix "${fallback}" |
+				awk '$2 ~ /^[TW]$/ && $1 ~ /^__[a-z0-9]*tf[a-z0-9]*$/ { print "--undefined=" $1 }' |
+				sort -u
+		)
+		[[ ${#binary128[@]} -gt 0 ]] || die "Missing i386 binary128 builtins"
+		ld.lld -m elf_i386 -r "${binary128[@]}" "${fallback}" \
+			-o "${builddir}/ekuos-binary128.o" || die
+		llvm-ar rs "${builddir}/libc.a" "${builddir}/ekuos-binary128.o" || die
+	fi
